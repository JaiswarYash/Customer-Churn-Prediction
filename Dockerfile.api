FROM python:3.11-slim

# Set working directory
WORKDIR /app

# install reqquirement
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# copy source code
COPY api/ ./api/
COPY models/ ./models/
COPY src/ ./src/

# Expose api port
EXPOSE 8000

# run 
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]